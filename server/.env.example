# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# Database
MONGO_URI=mongodb://localhost:27017/metalead

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-jwt-secret-here

# Admin Credentials
ADMIN_EMAIL=admin@metalead.com
ADMIN_PASSWORD=admin123

# Encryption Key (CRITICAL - generate with command below)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=6b979194b185d2ae7262bdb81421d6660645a9efcdd3b7e533145379a9d9eb1ed

# API Keys (will be encrypted automatically)
# META_ACCESS_TOKEN=your-meta-token
# SENDGRID_API_KEY=your-sendgrid-key
# OPENAI_API_KEY=your-openai-key

# Twilio (for SMS 2FA - optional)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# Server Configuration
PORT=4000
NODE_ENV=development

# CORS
CLIENT_URL=http://localhost:5173
